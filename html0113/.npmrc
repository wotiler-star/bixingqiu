# 本项目依赖停留在 2018 年（React 16 / webpack 3 / antd 3），
# 直接 npm install 在新版 npm 上会因 peer 依赖冲突和废弃的 postinstall 失败。
# 以下配置是让这套老依赖能在现代 npm 上装起来的最小集合。

# npm 7+ 默认严格校验 peer 依赖，老项目必开，否则大量 ERESOLVE 报错
legacy-peer-deps=true

# 这批依赖有大量历史 CVE，且多数已无维护分支，audit 输出只会淹没真正的错误
audit=false
fund=false

# webpack3 时代的老依赖有不少已废弃的 postinstall（部分在 Windows 下会挂起），
# 本项目全部为纯 JS 依赖，无需编译，跳过脚本可显著提速且避免安装卡死。
ignore-scripts=true

# 老包体积大、CDN 命中率低，放宽超时并允许重试
fetch-timeout=120000
fetch-retries=3
fetch-retry-maxtimeout=60000
progress=false

# 国内网络下若安装缓慢，可临时启用镜像（不建议提交到版本库）：
#   npm install --registry=https://registry.npmmirror.com
